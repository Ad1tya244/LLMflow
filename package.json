{
  "name": "llmflow",
  "private": true,
  "version": "0.1.0",
  "description": "Provider-agnostic LLM gateway with cost-aware routing and an analytics dashboard",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix dashboard run build",
    "test": "npm run test:api && npm run test:web",
    "test:api": "cd backend && .venv/bin/pytest -q",
    "test:web": "npm --prefix dashboard test",
    "check": "cd backend && .venv/bin/ruff check . && .venv/bin/ruff format --check . && .venv/bin/mypy src && cd ../dashboard && npm run typecheck",
    "bench": "cd backend && PYTHONPATH=src .venv/bin/python -m llmflow.bench run",
    "bench:report": "cd backend && PYTHONPATH=src .venv/bin/python -m llmflow.bench report",
    "smoke": "cd backend && PYTHONPATH=src .venv/bin/python scripts/smoke_test.py",
    "demo": "node scripts/demo.mjs",
    "provider": "cd backend && PYTHONPATH=src .venv/bin/python -m llmflow.tools.add_provider",
    "ops": "node scripts/ops.mjs",
    "rotate-master-key": "cd backend && PYTHONPATH=src .venv/bin/python -m llmflow.tools.rotate_master_key"
  }
}
