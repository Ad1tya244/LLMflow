# Copy to .env (never commit). `npm run dev` does this for you and generates keys.
# Operator keys: for your own apps calling /v1/* with the operator's provider keys.
# Admin keys: operator tooling only (`npm run ops`, /admin/*; Bearer only, no web UI).
# The two sets must not overlap. Each must be at least 16 characters.
LLMFLOW_API_KEYS=change-me-long-random-string
LLMFLOW_ADMIN_API_KEYS=
LLMFLOW_DATABASE_URL=sqlite+aiosqlite:///./llmflow.db

# Workspaces (bring-your-own provider keys). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK THIS UP: without it, stored provider keys cannot be decrypted. Comma-separate to rotate.
# LLMFLOW_MASTER_KEY=
# LLMFLOW_SIGNUP_ENABLED=false     # allow self-service sign-up on the dashboard
# LLMFLOW_SIGNUP_CODE=            # optional invite code required to sign up

# Optional limits (per client key, UTC day). Unset = unlimited.
# LLMFLOW_DAILY_BUDGET_USD=1.00
# LLMFLOW_DAILY_TOKEN_BUDGET=500000
# LLMFLOW_RATE_LIMIT_RPM=60
# LLMFLOW_CACHE_TTL_S=3600          # 0 disables the response cache
# LLMFLOW_TRUST_FORWARDED_FOR=true  # only when behind exactly one trusted proxy
# LLMFLOW_CORS_ORIGINS=https://your-dashboard.pages.dev
# LLMFLOW_ENABLE_DOCS=false
# LLMFLOW_SESSION_COOKIE_SAMESITE=lax   # 'none' (HTTPS only) if dashboard and API are on different sites

# Get a free key at https://console.groq.com
GROQ_API_KEY=
